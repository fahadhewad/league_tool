{
  "name": "leaguetool-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LeagueTool Electron desktop client and compliant in-game overlay",
  "main": "dist/main/main.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "undici": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^42.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  },
  "build": {
    "appId": "gg.leaguetool.desktop",
    "productName": "LeagueTool",
    "files": [
      "dist/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}

# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).

# ---- Riot API ----
# Get a key at https://developer.riotgames.com/ (dev keys expire every 24h).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Default routing region for Riot ID / match lookups: americas | europe | asia | sea
RIOT_DEFAULT_REGION=europe
# Default platform for summoner/league lookups: euw1 | na1 | kr | eun1 | br1 | ...
RIOT_DEFAULT_PLATFORM=euw1

# ---- Backend (Spring) ----
SERVER_PORT=8080
ML_SERVICE_URL=http://localhost:8001
# Shared secret guarding /api/v1/admin/** (crawler, static-data refresh). Leave blank to keep the
# admin surface disabled (fail-closed). Set to a long random string before deploying.
ADMIN_API_TOKEN=
# Pull the latest patch's champions from Data Dragon at startup (otherwise the bundled seed is used).
DDRAGON_REFRESH_ON_STARTUP=false

# ---- PostgreSQL ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=leaguetool
POSTGRES_USER=leaguetool
POSTGRES_PASSWORD=leaguetool

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- ML service (Python) ----
ML_PORT=8001
